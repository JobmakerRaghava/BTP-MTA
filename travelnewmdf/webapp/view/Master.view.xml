    <Table growing="true" mode="None" alternateRowColors="true" id="idTravelDetailsTable" sticky="HeaderToolbar,ColumnHeaders" items="{path:'taqasrv>/'}">
      <headerToolbar>
        <Toolbar >
          <Title text="{visible>/title}"></Title>
          <ToolbarSpacer ></ToolbarSpacer>

          <Button text="{i18n>create}" icon="sap-icon://add" press="onCreateRequestButtonPress" id="idCreateRequestButton" visible="{visible>/addbutton}"></Button>
          <!-- <Button icon="sap-icon://refresh" press="onRefreshTable"></Button>
          <Button icon="sap-icon://delete" press="onDeleteButtonPress"></Button> -->
        </Toolbar>
      </headerToolbar>
      <dependents>
        <plugins:ColumnResizer ></plugins:ColumnResizer>
      </dependents>
      <columns>
        <Column visible="false">
          <Label text="{i18n>ID}"></Label>
        </Column>
        <Column styleClass="border">
          <Label text="{i18n>TripNumber}"></Label>
        </Column>
        <Column styleClass="border">
          <Label text="{i18n>TravelType}"></Label>
        </Column>
        <Column styleClass="border">
          <Label text="{i18n>TravelCountry}"></Label>
        </Column>
        <Column styleClass="border">
          <Label text="{i18n>DepartureDate}"></Label>
        </Column>
        <Column styleClass="border">
          <Label text="{i18n>ReturnDate}"></Label>
        </Column>
        <Column styleClass="border">
          <Label text="{i18n>HomeCountry}"></Label>
        </Column>
        <!-- <Column styleClass="border">
                    <Label text="{i18n>TravelCountry}"></Label>
                </Column> -->
        <Column styleClass="border">
          <Label text="{i18n>Status}"></Label>
        </Column>
        <Column styleClass="border" hAlign="Center">
          <Label text="{i18n>Details}"></Label>
        </Column>
      </columns>
      <items>
        <ColumnListItem>
          <Text text="{taqasrv>ID}"></Text>
          <Text text="{taqasrv>TravelId}"></Text>
          <Text text="{taqasrv>TravelType}"></Text>
          <Text text="{taqasrv>TravelCountry}"></Text>
          <Text text="{taqasrv>Deparment}"></Text>
          <Text text="{taqasrv>Division}"></Text>
          <Text text="{taqasrv>HomeCountry}"></Text>
          <!-- <Text text="{travel>TravelCountry}"></Text> -->
          <!-- <ObjectStatus text="{travel>Status}" state="{=${travel>Status}==='Submitted'? 'Success':'Warning'}"></ObjectStatus> -->
          <Text text="{taqasrv>Status}"></Text>
          <Button icon="sap-icon://detail-view" press="onColumnListItemPress"></Button>
        </ColumnListItem>
      </items>

    </Table>
  </Page>
