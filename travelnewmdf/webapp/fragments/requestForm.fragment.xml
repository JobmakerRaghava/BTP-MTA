                    <u:FileUploader class="sapUiSmallMargin" name="myFileUpload" change="onFileUploaderChange"/>
                    <Button text="Upload File" class="sapUiSmallMargin" press="handleUploadPress"/>
                </HBox>

            </Panel>

        </content>
        <buttons>
            <!-- <Button text="{i18n>save}" press="onSaveAsDraftButtonPress" type="Emphasized" visible="{visible>/draft}"></Button> -->
            <Button text="{i18n>Review}" press="onSaveAsDraftButtonPress" type="Emphasized"></Button>
            <!-- <Button text="{i18n>delete}" press="onDeleteButtonPress" type="Emphasized" visible="{visible>/delete}"></Button> -->

            <Button text="{i18n>close}" type="Emphasized" press="onCloseButtonPress"></Button>
        </buttons>
    </Dialog>
</core:FragmentDefinition>